# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
stats.html
stats-*.json
.wxt
/autoload-extensions/
web-ext.config.ts
coverage/
playwright-report/
test-results/

# Secrets / local environment
.env*

# Internal-only — never open-sourced (agent settings, dev notes, scratch).
# .agent-memory.log is already covered by *.log above.
.claude/
internal-docs/
AGENTS.md

# Impeccable review captures are local visual QA artifacts; keep the capture script.
.impeccable/review/*.png

# Safari (generated by build:safari)
safari/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# A common global gitignore rule ("Icon" on macOS) swallows brand/icon — force it back in,
# then ignore only the renders inside it. Generated brand output is rebuilt by `just brand`.
!brand/icon/
brand/store/captures/
brand/store/out/
brand/icon/explore/
brand/icon/icon-1024.png
